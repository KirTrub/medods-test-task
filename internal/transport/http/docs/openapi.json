{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "2.1.0",
    "description": "CRUD API for tasks and recurring schedules. Supports automatic task generation with configurable deadlines."
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "tags": [
    { "name": "Tasks",     "description": "One-off and scheduled task instances" },
    { "name": "Schedules", "description": "Recurring task schedule templates" }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List all tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task manually",
        "description": "Creates a one-off task. To create a recurring task use the Schedules API — the scheduler will generate task instances automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" },
              "examples": {
                "minimal": {
                  "summary": "Title only",
                  "value": { "title": "Call patient Ivanov" }
                },
                "full": {
                  "summary": "All fields",
                  "value": {
                    "title": "Call patient Ivanov",
                    "description": "Discuss discharge plan",
                    "status": "new"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update a task",
        "description": "Updates title, description and status. deadline_at is managed by the scheduler and cannot be changed via this endpoint.",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/schedules": {
      "get": {
        "tags": ["Schedules"],
        "summary": "List all schedules",
        "responses": {
          "200": {
            "description": "Schedule list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Schedule" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Schedules"],
        "summary": "Create a recurring schedule",
        "description": "Creates a schedule template. Every day at midnight UTC the scheduler checks all schedules and generates a new task instance for each one that matches today's date. If `deadline_days` > 0, the generated task will have `deadline_at` set to today + deadline_days.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ScheduleRequest" },
              "examples": {
                "daily": {
                  "summary": "Every 2 days, 3-day deadline",
                  "value": {
                    "title": "Daily patient calls",
                    "description": "Call all patients on the list",
                    "type": "daily",
                    "every_n_days": 2,
                    "deadline_days": 3
                  }
                },
                "monthly": {
                  "summary": "On the 15th of each month",
                  "value": {
                    "title": "Monthly report",
                    "description": "Generate accounting report",
                    "type": "monthly",
                    "day_of_month": 15
                  }
                },
                "specific_dates": {
                  "summary": "Specific calendar dates",
                  "value": {
                    "title": "Quarterly review",
                    "type": "specific_dates",
                    "dates": ["2026-03-31", "2026-06-30", "2026-09-30", "2026-12-31"]
                  }
                },
                "parity": {
                  "summary": "Every even day",
                  "value": {
                    "title": "Inventory check",
                    "type": "parity",
                    "parity": "even"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/schedules/{id}": {
      "get": {
        "tags": ["Schedules"],
        "summary": "Get schedule by ID",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "responses": {
          "200": {
            "description": "Schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Schedules"],
        "summary": "Update a schedule",
        "description": "Updates the schedule template. Changes take effect on the next scheduler run. Already-generated tasks are not affected.",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ScheduleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Schedules"],
        "summary": "Delete a schedule",
        "description": "Deletes the schedule template. Existing tasks generated from it are kept (their schedule_id becomes null).",
        "parameters": [ { "$ref": "#/components/parameters/ResourceId" } ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64", "minimum": 1 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — validation error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Call patient Ivanov"
          },
          "description": {
            "type": "string",
            "example": "Discuss discharge plan"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "default": "new",
            "example": "new"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Call patient Ivanov"
          },
          "description": {
            "type": "string",
            "example": "Discuss discharge plan"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress",
            "description": "Note: overdue is a system-managed status set automatically when deadline_at is exceeded."
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Call patient Ivanov"
          },
          "description": {
            "type": "string",
            "example": "Discuss discharge plan"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done", "overdue"],
            "example": "new",
            "description": "overdue is set automatically by the scheduler when deadline_at < now and the task is not yet done."
          },
          "schedule_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Set when the task was auto-generated by a schedule. Null for manually created tasks.",
            "example": 3
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Deadline timestamp. Set automatically by the scheduler based on the schedule's deadline_days. Null if no deadline.",
            "example": "2026-04-25T00:00:00Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          }
        }
      },
      "ScheduleRequest": {
        "type": "object",
        "required": ["title", "type"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Daily patient calls"
          },
          "description": {
            "type": "string",
            "example": "Call every patient on the list"
          },
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific_dates", "parity"],
            "example": "daily",
            "description": "Determines which additional field is required: daily→every_n_days, monthly→day_of_month, specific_dates→dates, parity→parity"
          },
          "every_n_days": {
            "type": "integer",
            "minimum": 1,
            "example": 1,
            "description": "Required when type=daily. A task is created every N days starting from the schedule creation date."
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "example": 15,
            "description": "Required when type=monthly. A task is created on this calendar day each month."
          },
          "dates": {
            "type": "array",
            "items": { "type": "string", "format": "date", "example": "2026-06-30" },
            "description": "Required when type=specific_dates. A task is created only on these exact dates (YYYY-MM-DD)."
          },
          "parity": {
            "type": "string",
            "enum": ["even", "odd"],
            "example": "even",
            "description": "Required when type=parity. A task is created on even or odd days of the month."
          },
          "deadline_days": {
            "type": "integer",
            "minimum": 0,
            "example": 3,
            "description": "Optional. When > 0, generated tasks will have deadline_at = task creation date + deadline_days. 0 means no deadline."
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Daily patient calls"
          },
          "description": {
            "type": "string",
            "example": "Call every patient on the list"
          },
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific_dates", "parity"],
            "example": "daily"
          },
          "every_n_days": {
            "type": "integer",
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "example": 15
          },
          "dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" }
          },
          "parity": {
            "type": "string",
            "enum": ["even", "odd"]
          },
          "deadline_days": {
            "type": "integer",
            "example": 3,
            "description": "Number of days from task creation until deadline_at. 0 means no deadline."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "schedule not found" }
        }
      }
    }
  }
}